# ---- server ----
NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# ---- database ----
# PostGIS-enabled Postgres. docker-compose.yml provisions exactly this.
DATABASE_URL=postgres://missedmoments:missedmoments@localhost:5432/missedmoments

# ---- redis ----
REDIS_URL=redis://localhost:6379

# ---- auth ----
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production-min-32-chars-long-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- google ----
# Needs "Places API" and "Geocoding API" enabled.
# Restrict the key by IP to your server: it is used server-side only and must
# never be shipped inside the mobile app.
GOOGLE_MAPS_API_KEY=

# ---- product tuning ----
# Two people are "a moment" if they were within this many metres...
MOMENT_RADIUS_METRES=150
# ...and within this many minutes of each other.
MOMENT_WINDOW_MINUTES=60
