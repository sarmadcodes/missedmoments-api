# Production environment template. Copy to .env on the server and fill in
# every value below -- this file itself has no real secrets and is safe to
# commit. NEVER commit the real .env.
#
#   cp .env.production.example .env
#   nano .env

NODE_ENV=production
PORT=4100
LOG_LEVEL=info

# ---- database ----
# PostGIS-enabled Postgres. Must have the postgis extension available --
# `CREATE EXTENSION postgis;` must succeed against it (see deploy notes for
# installing postgis on the server's Postgres).
DATABASE_URL=postgres://missedmoments:CHANGE_ME@localhost:5432/missedmoments

# ---- redis ----
REDIS_URL=redis://localhost:6379

# ---- auth ----
# Generate with: openssl rand -base64 48
# Rotating this logs out every signed-in user -- do not change it casually
# once real users exist.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- google ----
# Needs "Places API (New)" and "Geocoding API" enabled in Google Cloud.
# Restrict the key by server IP: it is used server-side only, never shipped
# in the app.
GOOGLE_MAPS_API_KEY=

# ---- cloudinary (image uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Keep false until an automated moderation provider is wired in -- every
# upload is held for admin review at /admin instead of publishing instantly.
PHOTO_AUTO_APPROVE=false

# ---- product tuning ----
MOMENT_RADIUS_METRES=150
MOMENT_WINDOW_MINUTES=60

# One-off secret gating scripts/make-admin.mjs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_BOOTSTRAP_KEY=

# ---- push notifications (optional) ----
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key -> paste the whole downloaded JSON as one line. Leave empty to
# ship without push for now; nothing else breaks.
FIREBASE_SERVICE_ACCOUNT_JSON=
